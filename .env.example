NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/malfranza
FRONTEND_URL=http://localhost:8081
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=86400
ADMIN_BOOTSTRAP_KEY=replace-with-a-secure-one-time-bootstrap-key
GOOGLE_MAPS_API_KEY=replace-with-google-routes-api-key
TAXI_BASE_FARE_USD=25
TAXI_PER_KM_USD=0
TAXI_MINIMUM_FARE_USD=25
TAXI_EXTRA_PASSENGER_USD=5
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Guest booking + signup OTP emails (Gmail app password recommended).
# Use either SMTP_* or EMAIL_* (EMAIL_* is an alias). Leave blank to log emails in console.
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional aliases (same as SMTP_USER / SMTP_PASS)
DEFAULT_SMTP_EMAIL=
DEFAULT_SMTP_PASSWORD=
# Owner/admin alert inbox (defaults to SMTP_USER)
ADMIN_NOTIFY_EMAIL=

# Beds24 demo integration (API v2). Prefer refresh token from Marketplace > API.
BEDS24_API_BASE=https://api.beds24.com/v2
BEDS24_REFRESH_TOKEN=
BEDS24_ACCESS_TOKEN=

# PayPal REST API (use Sandbox for testing)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

